{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "es2019",
    "lib": ["es2019"],
    "outDir": "./dist",
    "rootDir": "./nodes",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["nodes/**/*.ts"]
}